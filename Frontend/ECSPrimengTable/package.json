{
  "name": "primeng-table-reusable-component",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:tree": "ng build ecs-primeng-table && ng build ECSPrimengTable --configuration development && node --test tests/tree-state.test.mjs",
    "test:tree:browser": "ng build ecs-primeng-table && ng build ECSPrimengTable --configuration development && node tests/tree.browser.mjs",
    "test:state": "ng build ecs-primeng-table && node --test tests/navigation-state.test.mjs",
    "test:responsive": "ng build ecs-primeng-table && node --test tests/responsive.test.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "14.2.12",
    "@angular/common": "14.2.12",
    "@angular/compiler": "14.2.12",
    "@angular/core": "14.2.12",
    "@angular/forms": "14.2.12",
    "@angular/platform-browser": "14.2.12",
    "@angular/platform-browser-dynamic": "14.2.12",
    "@angular/router": "14.2.12",
    "@ngx-translate/core": "14.0.0",
    "@ngx-translate/http-loader": "7.0.0",
    "primeicons": "6.0.1",
    "primeng": "14.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.11.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "14.2.13",
    "@angular/cli": "14.2.13",
    "@angular/compiler-cli": "14.2.12",
    "ng-packagr": "14.2.2",
    "playwright": "1.56.1",
    "typescript": "4.8.4"
  }
}
